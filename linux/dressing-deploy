#!/usr/bin/env bash
# /usr/local/bin/dressing-deploy <release.tar.gz in /srv/releases>
# Root-owned; devops and automation_bot may run it via sudo. It is the ONLY way they change
# /opt/dressing, so what a deploy can do is fixed here rather than in sudoers.
set -euo pipefail
name="$(basename "${1:?usage: dressing-deploy <release.tar.gz>}")"
[[ "$name" =~ ^dressing-api-[0-9A-Za-z._-]+\.tar\.gz$ ]] || { echo "bad release name: $name"; exit 1; }
src="/srv/releases/$name"
[[ -f "$src" ]] || { echo "no such release: $src"; exit 1; }

new="/opt/dressing/releases/${name%.tar.gz}"
install -d -m 0750 -o root -g dressing /opt/dressing/releases "$new"
tar -xzf "$src" -C "$new" --no-same-owner --no-same-permissions
chown -R root:dressing "$new"
chmod -R u=rwX,g=rX,o= "$new"

ln -sfn "$new" /opt/dressing/current
systemctl restart dressing-api
sleep 2
systemctl is-active --quiet dressing-api && echo "deployed $name" || { journalctl -u dressing-api -n 30 --no-pager; exit 1; }
