Defaults  env_reset
Defaults  secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Defaults  logfile="/var/log/sudo.log"

Cmnd_Alias  APP = /usr/bin/systemctl start dressing-api, /usr/bin/systemctl stop dressing-api, \
                  /usr/bin/systemctl restart dressing-api, /usr/bin/systemctl status dressing-api
Cmnd_Alias  DB  = /usr/bin/systemctl restart postgresql, /usr/bin/systemctl status postgresql

%sysadmins      ALL=(ALL:ALL) ALL
%devops         ALL=(root) APP
automation_bot  ALL=(root) NOPASSWD: APP
%developers     ALL=(root) /usr/bin/systemctl status dressing-api
%dba            ALL=(postgres) /usr/bin/psql
%dba            ALL=(root) DB
