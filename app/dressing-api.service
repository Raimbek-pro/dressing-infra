# /etc/systemd/system/dressing-api.service
[Unit]
Description=Dressing backend API
After=network-online.target
Wants=network-online.target

[Service]
User=dressing
EnvironmentFile=/etc/dressing/dressing.env
ExecStart=/usr/bin/python3 /opt/dressing/dressing_api.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
